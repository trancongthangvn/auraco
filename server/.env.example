DATABASE_URL=postgres://user:password@localhost:5432/auraco
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Optional — purges a deleted upload's Cloudflare cache immediately instead
# of leaving it publicly reachable for up to the 30-day max-age (see
# server/lib/cloudflare.js). Left unset, deletes still work, just without
# the purge (logged as a warning, not an error). CF_ZONE_ID is maxmin.vn's
# zone; the token needs the "Cache Purge: Edit" permission on that zone.
CF_API_TOKEN=
CF_ZONE_ID=

# Optional — order-confirmation email via Resend (resend.com). Left unset,
# orders are still created normally, just without the email (logged as a
# warning). EMAIL_FROM's domain must be verified in the Resend account
# (SPF/DKIM DNS records added) or sending will fail/land in spam.
RESEND_API_KEY=
EMAIL_FROM=AURA & CO <orders@aura.maxmin.vn>

# Optional — Airwallex payment gateway (Card / PayPal / Klarna in one
# integration). Left unset, POST /orders/:id/airwallex-intent returns 503
# and the "airwallex" method stays disabled in payment_method_settings.
# AIRWALLEX_ENV: 'demo' (sandbox, default) or 'prod'.
# AIRWALLEX_CLIENT_ID / AIRWALLEX_API_KEY: Airwallex dashboard > Developer > API keys.
# AIRWALLEX_WEBHOOK_SECRET: the webhook's own settings page in the dashboard
#   (create a webhook pointed at https://<domain>/api/webhooks/airwallex
#   subscribed to payment_intent.succeeded/failed/cancelled — NOT the API key).
# AIRWALLEX_CURRENCY: checkout currency, defaults to USD.
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_CURRENCY=USD
